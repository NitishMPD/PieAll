{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PieAll",
  "version": "0.1.0",
  "identifier": "com.nitish.pieall",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "dashboard",
        "title": "PieAll",
        "decorations": false,
        "width": 1040,
        "height": 740,
        "minWidth": 640,
        "minHeight": 540,
        "visible": false,
        "backgroundColor": "#F5EFE5"
      },
      {
        "label": "ring",
        "title": "PieAll actions",
        "url": "index.html?surface=ring",
        "width": 440,
        "height": 440,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "toast",
        "title": "PieAll notice",
        "url": "index.html?surface=toast",
        "width": 460,
        "height": 88,
        "visible": false,
        "focus": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://localhost:1420 http://127.0.0.1:1420 ws://localhost:1420 ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Nitish",
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": { "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt" },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh",
        "compression": "lzma"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/NitishMPD/PieAll/releases/latest/download/latest.json"
      ],
      "pubkey": "",
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
